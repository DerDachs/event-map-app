{
  "$description": "Market Mate design tokens (W3C Design Tokens format). Single source of truth: run `python3 brand/tools/build_tokens.py` after editing to regenerate tokens.css and lib/theme/brand_tokens.dart.",
  "color": {
    "$type": "color",
    "brand": {
      "red":       { "$value": "#C62828", "$description": "Marktrot – Primärfarbe: Logo, Buttons, Links, Akzente" },
      "red-dark":  { "$value": "#9E1F1F", "$description": "Marktrot dunkel – Hover, Fließtext-Links" },
      "gold":      { "$value": "#F9A825", "$description": "Lichtergold – Akzent, sparsam: Markisenstreifen, Highlights. Nie weiße Schrift auf Gold" },
      "gold-soft": { "$value": "#FFF3D6", "$description": "Gold-Tönung für Hinweise und Badges" },
      "gold-ink":  { "$value": "#8A5A00", "$description": "Schrift auf gold-soft" },
      "green":     { "$value": "#2E7D32", "$description": "Tannengrün – unterstützend, z. B. Erfolg, Handwerk" }
    },
    "neutral": {
      "ink":       { "$value": "#2B2B2B", "$description": "Kohle – Text, dunkle Flächen, primärer Button" },
      "ink-soft":  { "$value": "#5C5C5C", "$description": "Sekundärtext" },
      "paper":     { "$value": "#FBFAF8", "$description": "Papier – Seitenhintergrund" },
      "sand":      { "$value": "#F3EFE8", "$description": "Sand – abgesetzte Sektionen" },
      "line":      { "$value": "#E7E3DD", "$description": "Linien und Kartenränder" },
      "white":     { "$value": "#FFFFFF", "$description": "Karten, Text auf Rot" }
    },
    "dark": {
      "bg":        { "$value": "#1E1C1B", "$description": "Dunkler Hintergrund (Abendmarkt)" },
      "surface":   { "$value": "#2B2B2B", "$description": "Karten auf dunklem Grund" },
      "text":      { "$value": "#F3EFE8", "$description": "Text auf dunklem Grund" },
      "text-soft": { "$value": "#BDB7AE", "$description": "Sekundärtext auf dunklem Grund" },
      "link":      { "$value": "#FF8A80", "$description": "Links/Rot-Akzent auf dunklem Grund (Marktrot ist dort zu dunkel für Text)" }
    },
    "category": {
      "$description": "Funktionale Kartenfarben je Stand-Kategorie. Gleiche Keys wie lib/features/market_builder/models/stand_categories.dart.",
      "gluehwein":   { "$value": "#C62828", "$description": "Glühwein & Heißgetränke" },
      "food_savory": { "$value": "#EF6C00", "$description": "Herzhaftes" },
      "food_sweet":  { "$value": "#AD1457", "$description": "Süßes & Gebäck" },
      "crafts":      { "$value": "#2E7D32", "$description": "Handwerk & Geschenke" },
      "decoration":  { "$value": "#F9A825", "$description": "Weihnachtsdeko" },
      "kids":        { "$value": "#6A1B9A", "$description": "Für Kinder" },
      "stage":       { "$value": "#1565C0", "$description": "Bühne & Programm" },
      "service":     { "$value": "#455A64", "$description": "Service" },
      "other":       { "$value": "#6D4C41", "$description": "Sonstiges" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Bebas Neue", "Oswald", "Arial Narrow", "sans-serif"], "$description": "Headlines, immer in Großbuchstaben" },
    "body":    { "$value": ["Figtree", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Fließtext, UI, Buttons" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "8px" },
    "md":   { "$value": "14px", "$description": "Karten" },
    "lg":   { "$value": "24px", "$description": "große Flächen, CTA-Boxen" },
    "pill": { "$value": "999px", "$description": "Buttons, Chips, Navigation" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" }
  }
}
