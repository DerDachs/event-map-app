#include? "../Pods/Pods-Runner.debug (staging).xcconfig"
#include? "../Pods/Pods-Runner.release (staging).xcconfig"
// Flutter build settings (paths, version, build number), regenerated by every flutter build
#include "Flutter/Generated.xcconfig"
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64


// Backward Compatible Values
IS_PRODUCTION = NO
ENV_NAME = staging

// Overriding (do NOT change key name)
// app name
PRODUCT_NAME = Market Mate $(ENV_NAME)
// bundle id
PRODUCT_BUNDLE_IDENTIFIER = com.tdwdevelopments.event-map.$(ENV_NAME)
// app icon
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon_NonProduction
// app version
MARKETING_VERSION = 1.0.1
// build number
CURRENT_PROJECT_VERSION = 1
