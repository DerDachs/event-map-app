rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Users manage their own profile but cannot make themselves admin.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.get('role', 'user') == 'user';
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Events are created by admins. Visitors may only join (participants)
    // and link teams (teamIds).
    match /events/{eventId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'teamIds']));
    }

    match /stands/{standId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /category/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Start page posts, written by admins.
    match /feed/{postId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Seasons (Weihnachten, Pfingsten …) for the start page, set by admins.
    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read, write: if signedIn();
    }
  }
}
