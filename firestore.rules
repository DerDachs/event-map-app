rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Users manage their own profile but cannot make themselves admin.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.get('role', 'user') == 'user';
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A market with an uploaded site plan needs the uploader's confirmation
    // that the plan may be used (see plan_consent.dart). Markets from before
    // the confirmation existed stay editable as long as the plan is untouched.
    function planConsented(data) {
      return data.get('planConsent', {}).get('granted', false) == true;
    }

    function createsValidPlan(data) {
      return !('plan' in data) || planConsented(data);
    }

    function keepsValidPlan(data, old) {
      return !('plan' in data) || planConsented(data) ||
        data.get('plan', null) == old.get('plan', null);
    }

    // Events are created by admins. Visitors may only join (participants)
    // and link teams (teamIds).
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if isAdmin() && createsValidPlan(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && keepsValidPlan(request.resource.data, resource.data)) || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'teamIds']));
    }

    match /stands/{standId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /category/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Start page posts, written by admins.
    match /feed/{postId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Seasons (Weihnachten, Pfingsten …) for the start page, set by admins.
    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read, write: if signedIn();
    }
  }
}
